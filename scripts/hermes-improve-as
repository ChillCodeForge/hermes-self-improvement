#!/usr/bin/env bash
# Run hermes-improve as a provisioned role user.
#
# Usage: hermes-improve-as [--root DIR] <agent|evaluator|promoter> <hermes-improve args...>
#
# Run as root (or as the role user itself). The environment is rebuilt from the
# root-owned DIR/config/roles/<role>.env written by scripts/provision.sh; the
# caller's environment is discarded. Privileges are dropped with setpriv:
# target UID/GID, the user's own supplementary groups, no_new_privs (setuid
# binaries such as sudo cannot raise privileges), and empty capability sets.
# Each role may only run the subcommands that belong to it.
set -euo pipefail

ROOT=/srv/hermes-improve
die() { echo "hermes-improve-as: $*" >&2; exit 2; }

if [[ "${1:-}" == --root ]]; then
  ROOT="${2:?--root needs a value}"; shift 2
fi
[[ $# -ge 2 ]] || die "usage: hermes-improve-as [--root DIR] <agent|evaluator|promoter> <args...>"
ROLE="$1"; shift
[[ "$ROOT" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "unsafe root: $ROOT"

command="$1"
sub="${2:-}"
allowed=0
case "$ROLE" in
  agent)
    case "$command" in
      status|ingest|ingest-batch|dream|candidates|experiments|evolve|security) allowed=1 ;;
      candidate) [[ "$sub" =~ ^(create|export|sync-baseline)$ ]] && allowed=1 ;;
      benchmarks) [[ "$sub" =~ ^(list|validate|mine|candidates|inspect-candidate)$ ]] && allowed=1 ;;
    esac ;;
  evaluator)
    case "$command" in
      status|evaluate|candidates|experiments|security) allowed=1 ;;
      candidate) [[ "$sub" == import ]] && allowed=1 ;;
      benchmarks) [[ "$sub" =~ ^(list|validate)$ ]] && allowed=1 ;;
    esac ;;
  promoter)
    case "$command" in
      status|promote|rollback|releases|monitor|experiments|security) allowed=1 ;;
    esac ;;
  *) die "unknown role: $ROLE" ;;
esac
[[ "$allowed" -eq 1 ]] || die "role $ROLE may not run: hermes-improve $command${sub:+ $sub}"

trusted_file() {  # path must be root-owned and not group/other writable, as must its parents
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || die "$path is missing or not a regular file"
  local check="$path"
  while [[ "$check" != / ]]; do
    read -r owner perms < <(stat -c '%u %a' "$check")
    [[ "$owner" -eq 0 ]] || die "$check must be root-owned"
    # Shared-writable parents are tolerated only with the sticky bit (e.g. /var/tmp).
    if (( 8#$perms & 8#022 )) && ! [[ "$check" != "$path" ]] || \
       { (( 8#$perms & 8#022 )) && ! (( 8#$perms & 8#1000 )); }; then
      die "$check must not be group/other writable"
    fi
    check="$(dirname "$check")"
  done
}

ENV_FILE="$ROOT/config/roles/$ROLE.env"
trusted_file "$ENV_FILE"
declare -a envs=("PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" "LANG=C.UTF-8")
user="" cli="" manifest_key_file=""
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "$line" ]] && continue
  key="${line%%=*}"
  value="${line#*=}"
  case "$key" in
    HERMES_IMPROVE_USER) user="$value" ;;
    HERMES_IMPROVE_CLI) cli="$value" ;;
    HERMES_IMPROVE_MANIFEST_KEY_FILE) manifest_key_file="$value" ;;
    HERMES_IMPROVE_LAYOUT|HERMES_IMPROVE_BENCHMARKS|HERMES_IMPROVE_HOME|HERMES_IMPROVE_CONFIG|HERMES_EVALUATOR_UID|\
    HERMES_PROMOTER_UID|HERMES_EVALUATOR_PRIVATE_KEY|HOME|TMPDIR) envs+=("$key=$value") ;;
    *) die "unexpected key in $ENV_FILE: $key" ;;
  esac
done < "$ENV_FILE"
[[ "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid role user in $ENV_FILE"
[[ "$cli" = /* && -x "$cli" ]] || die "invalid HERMES_IMPROVE_CLI in $ENV_FILE"

if [[ -n "$manifest_key_file" ]]; then
  [[ -r "$manifest_key_file" ]] || die "cannot read promotion manifest key"
  envs+=("HERMES_IMPROVE_MANIFEST_KEY=$(cat "$manifest_key_file")")
fi

if [[ "$(id -u)" -ne 0 ]]; then
  [[ "$(id -un)" == "$user" ]] || die "run as root or as $user"
  cd "$ROOT"
  exec env -i "${envs[@]}" "$cli" "$@"
fi
uid="$(id -u "$user")"
gid="$(id -g "$user")"
[[ "$uid" -ne 0 && "$gid" -ne 0 ]] || die "$user must not be root"
cd "$ROOT"
exec setpriv --reuid="$uid" --regid="$gid" --init-groups --no-new-privs \
  --inh-caps=-all --bounding-set=-all -- env -i "${envs[@]}" "$cli" "$@"
